{
  "name": "luna-nihongo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:vite": "npm run curriculum:build && vite",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:api:php": "php -S localhost:8080 -t public",
    "dev:all": "npm run curriculum:build && node scripts/dev-all.mjs",
    "prebuild": "npm run curriculum:check",
    "build": "node scripts/generate-gemini-secret.mjs && npm run curriculum:build && tsc -b && vite build",
    "build:hostinger": "bash scripts/build-hostinger.sh",
    "curriculum:check": "node content/curriculum/hydrate.mjs --check",
    "curriculum:build": "node content/curriculum/hydrate.mjs",
    "curriculum:insert": "node content/curriculum/insert-units.mjs",
    "kanjivg:bundle": "node scripts/build-kanjivg-bundle.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:env": "node scripts/check-firebase-env.mjs",
    "check:firebase": "npm run check:env",
    "functions:install": "npm install --prefix functions",
    "functions:build": "npm run build --prefix functions",
    "functions:deploy": "npm run build --prefix functions && firebase deploy --only functions",
    "functions:allow-public": "npm run allow-public --prefix functions",
    "functions:allow-public:gcloud": "npm run allow-public:gcloud --prefix functions",
    "test": "node --test tests/**/*.test.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
