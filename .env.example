# Firebase (Console → Project Settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo per build/deploy server e dev locale Luna Live/TTS (NON committare valori reali)
GEMINI_API_KEY=

# Firebase Functions emulator (dev)
# VITE_USE_FUNCTIONS_EMULATOR=true

# Blog RSS / sitemap (Cloud Functions URLs after deploy)
# VITE_BLOG_RSS_URL=https://europe-west1-luna-nihongo.cloudfunctions.net/blogRss
# VITE_BLOG_SITEMAP_URL=https://europe-west1-luna-nihongo.cloudfunctions.net/blogSitemap

# Phase 2 — Simli avatar (optional)
# VITE_SIMLI_API_KEY=
# VITE_SIMLI_FACE_ID=

# Hostinger PHP — verify Firebase ID tokens on live-session.php (same as web app key)
# FIREBASE_WEB_API_KEY=

# Firebase Functions — Stripe Premium (set via firebase functions:secrets:set)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=price_...
