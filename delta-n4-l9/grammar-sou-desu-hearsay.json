{
  "id": "grammar-sou-desu-hearsay",
  "level": 9,
  "order": 4,
  "type": "grammar",
  "contentVersion": 1,
  "title": {
    "it": "Grammatica · 〜そうです (ho sentito che)",
    "en": "Grammar · ~sou desu (hearsay)"
  },
  "description": {
    "it": "Questo 〜そうです riporta ciò che hai sentito ('ho sentito che, pare che'): あしたはあめだそうです. Si attacca alla forma piana COMPLETA (con だ per nomi/aggettivi -な). Non confonderlo con il そうです dell'apparenza: qui riporti un'informazione ricevuta, non ciò che vedi.",
    "en": "This 〜そうです reports what you heard ('I heard that, apparently'): あしたはあめだそうです. It attaches to the FULL plain form (with だ for nouns/na-adjectives). Don't confuse it with the appearance そうです: here you report received information, not what you see."
  },
  "grammarRefs": [
    "gr-sou-desu-hearsay"
  ],
