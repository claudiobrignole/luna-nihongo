{
  "name": "luna-nihongo-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "allow-public": "node ../scripts/allow-live-callables-public.mjs",
    "allow-public:gcloud": "bash ../scripts/allow-public-gcloud.sh"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.6.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
