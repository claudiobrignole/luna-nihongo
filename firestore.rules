rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPrimarySuperAdmin() {
      return isSignedIn()
        && request.auth.token.email.lower() == 'claudio@brignole.ch';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && userDoc().role == 'super_admin';
    }

    function isTeacher() {
      return isSignedIn() && userDoc().role == 'teacher';
    }

    function isStaff() {
      return isSignedIn() && userDoc().role in ['super_admin', 'teacher'];
    }

    function protectedSuperAdminEmail() {
      return 'claudio@brignole.ch';
    }

    function isProtectedAccount(email) {
      return email.lower() == protectedSuperAdminEmail();
    }

    function ownerLiveQuotaUpdateAllowed(uid) {
      return isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['liveMinutesUsed', 'liveMinutesWindowStart', 'liveMinutesPeriod', 'updatedAt'])
        && request.resource.data.liveMinutesUsed >= resource.data.liveMinutesUsed
        && request.resource.data.liveMinutesUsed <= resource.data.liveMinutesUsed + 10;
    }

    function ownerLiveQuotaChangeOk(uid) {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['liveMinutesUsed', 'liveMinutesWindowStart', 'liveMinutesPeriod'])
        || ownerLiveQuotaUpdateAllowed(uid);
    }

    function ownerCannotChangeStripeFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'stripeCustomerId',
          'stripeSubscriptionId',
          'subscriptionStatus',
          'subscriptionPeriodStart',
          'subscriptionPeriodEnd',
          'includedLessonsUsed',
          'graceCancellationsIncludedUsed',
          'graceCancellationsExtraUsed',
          'extraRebookCredit',
          'replacementLessonCredit',
        ]);
    }

    function ownerCannotChangeTrialFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['trialStartedAt', 'trialEndsAt', 'trialUsed', 'introCallBookedAt']);
    }

    function ownerCannotChangeServerEmailFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'sendfoxSyncedAt',
          'premiumWelcomeSentAt',
          'graceNoSlotsCouponCycleKey',
          'graceCancellationsIncludedUsed',
          'graceCancellationsExtraUsed',
          'extraRebookCredit',
          'replacementLessonCredit',
        ]);
    }

    function ownerCannotChangeRoleOrTier() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'tier']);
    }

    function staffTierManagedKeys() {
      return [
        'tier',
        'updatedAt',
        'messagesCount',
        'liveMinutesUsed',
        'liveMinutesPeriod',
        'liveMinutesWindowStart',
        'premiumEndedAt',
        'subscriptionStatus',
        'subscriptionPeriodStart',
        'subscriptionPeriodEnd',
        'includedLessonsUsed',
        'graceCancellationsIncludedUsed',
        'graceCancellationsExtraUsed',
        'extraRebookCredit',
        'replacementLessonCredit',
      ];
    }

    function onlyTierChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(staffTierManagedKeys());
    }

    function onlyRoleOrTierChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['role'].concat(staffTierManagedKeys()));
    }

    function teacherProfileKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['teacherDisplayName', 'updatedAt']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();

      allow create: if isOwner(userId)
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && (
          request.resource.data.role == 'user'
          || (isPrimarySuperAdmin() && request.resource.data.role == 'super_admin')
        );

      allow update: if isOwner(userId)
        && ownerLiveQuotaChangeOk(userId)
        && ownerCannotChangeStripeFields()
        && ownerCannotChangeTrialFields()
        && ownerCannotChangeServerEmailFields()
        && ownerCannotChangeRoleOrTier()
        && (
          !isTeacher()
          || teacherProfileKeysOnly()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherDisplayName', 'updatedAt'])
        );

      allow update: if isSuperAdmin()
        && !isOwner(userId)
        && onlyRoleOrTierChanged()
        && request.resource.data.role in ['user', 'teacher', 'super_admin']
        && (
          !isProtectedAccount(resource.data.email)
          || request.resource.data.role == 'super_admin'
        );

      allow delete: if isSuperAdmin()
        && !isProtectedAccount(resource.data.email);

      match /srs/{cardId} {
        allow read, write: if isOwner(userId);
      }

      match /bookings/{bookingId} {
        allow read: if isOwner(userId) || isStaff();
        allow create, update, delete: if false;
      }

      match /activity/{activityId} {
        allow read: if isOwner(userId) || isStaff();
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      match /liveSessions/{sessionId} {
        allow read: if isOwner(userId) || isStaff();
        allow write: if false;
      }
    }

    match /availabilitySlots/{slotId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin()
        || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update: if isSuperAdmin()
        || (isTeacher()
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.teacherId == request.auth.uid);
      allow delete: if isSuperAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /teacherPayouts/{teacherId}/months/{monthId} {
      allow read: if isSuperAdmin() || (isTeacher() && request.auth.uid == teacherId);
      allow write: if isSuperAdmin();
    }

    match /trialIpClaims/{claimId} {
      allow read, write: if false;
    }

    match /newsletterAttempts/{attemptId} {
      allow read, write: if false;
    }

    match /coupons/{couponId} {
      allow read: if isSignedIn()
        && (
          resource.data.redeemedByUid == request.auth.uid
          || resource.data.purchasedByUid == request.auth.uid
        );
      allow create, update, delete: if false;
    }

    match /blogPosts/{postId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }
  }
}
