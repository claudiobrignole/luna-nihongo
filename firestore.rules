rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPrimarySuperAdmin() {
      return isSignedIn()
        && request.auth.token.email.lower() == 'claudio@brignole.ch';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && userDoc().role == 'super_admin';
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role in ['super_admin', 'admin'];
    }

    function isAdminOnly() {
      return isSignedIn() && userDoc().role == 'admin';
    }

    function protectedSuperAdminEmail() {
      return 'claudio@brignole.ch';
    }

    function isProtectedAccount(email) {
      return email.lower() == protectedSuperAdminEmail();
    }

    function ownerLiveQuotaUpdateAllowed(uid) {
      return isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['liveMinutesUsed', 'liveMinutesPeriod', 'updatedAt'])
        && request.resource.data.liveMinutesUsed >= resource.data.liveMinutesUsed
        && request.resource.data.liveMinutesUsed <= resource.data.liveMinutesUsed + 10;
    }

    function ownerCannotChangeLiveQuota(uid) {
      return !ownerLiveQuotaUpdateAllowed(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['liveMinutesUsed', 'liveMinutesPeriod']);
    }

    function onlyTierChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['tier', 'updatedAt', 'messagesCount', 'liveMinutesUsed', 'liveMinutesPeriod']);
    }

    function onlyRoleOrTierChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['role', 'tier', 'updatedAt', 'messagesCount']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && (
          request.resource.data.role == 'user'
          || (isPrimarySuperAdmin() && request.resource.data.role == 'super_admin')
        );

      allow update: if isOwner(userId)
        && ownerCannotChangeLiveQuota(userId)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || isSuperAdmin()
          || isPrimarySuperAdmin()
        )
        && (
          !isProtectedAccount(resource.data.email)
          || request.resource.data.role == 'super_admin'
        );

      allow update: if isSuperAdmin()
        && !isOwner(userId)
        && onlyRoleOrTierChanged()
        && request.resource.data.role in ['user', 'admin', 'super_admin']
        && (
          !isProtectedAccount(resource.data.email)
          || request.resource.data.role == 'super_admin'
        );

      allow update: if isAdminOnly()
        && !isOwner(userId)
        && resource.data.role == 'user'
        && request.resource.data.role == 'user'
        && onlyTierChanged();

      allow delete: if isSuperAdmin()
        && !isProtectedAccount(resource.data.email);

      match /srs/{cardId} {
        allow read, write: if isOwner(userId);
      }

      match /bookings/{bookingId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId);
      }

      match /activity/{activityId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      match /liveSessions/{sessionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }
  }
}
